// Prisma schema — Solanum (local-first, SQLite).
// The schema is kept Postgres-compatible (no SQLite-only features) so the
// database can be migrated to a hosted Postgres at deploy time (ADR-002).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Exec-board member who logs in to operate Solanum (NF-8).
// Participants never log in (NF-2); they are a separate entity added in later features.
model Operator {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// A mission/trip whose participants move through the funnel (FEAT-004).
// Per-transition deadlines: an absolute trip-level date wins when set;
// otherwise the matching *DeadlineDays column is a relative fallback
// (N days after the participant entered the state), per FR-003.
model Trip {
  id                           String        @id @default(uuid())
  name                         String
  registrationClose            DateTime?
  contractDate                 DateTime?
  contractSignedDeadlineDays   Int?
  firstPaymentDate             DateTime?
  depositConfirmedDeadlineDays Int?
  flightsDate                  DateTime?
  gracePeriodDays              Int           @default(0)
  timezone                     String        @default("America/Mexico_City")
  createdAt                    DateTime      @default(now())
  participants                 Participant[]
  agencyDocuments              AgencyDocument[]
  priceTiers                   PriceTier[]
}

// A student moving through the funnel toward a confirmed trip seat.
// Funnel-management fields from FEAT-004 (board-manual add/view path,
// FR-004/005/006); F1 intake fields from FEAT-001 (public self-registration,
// FR-001). full_name is intentionally not a column — it is derived from
// firstName + lastName wherever displayed (sanctioned by the FEAT-001 doc's
// own note that the field "may be dropped if concatenated").
model Participant {
  id                   String    @id @default(uuid())
  tripId               String
  trip                 Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  firstName            String
  lastName             String
  email                String
  preferredName        String?
  studentId            String?
  age                  Int?
  career               String?
  semester             String?
  phone                String?
  instagram            String?
  nationality          String?
  passportStatus       String?
  visaStatus           String?
  whatsappGroupConsent Boolean?
  privacyConsent       Boolean?
  consentTimestamp     DateTime?
  currentState         String    @default("Registered (F1)")
  contractSigned       Boolean   @default(false)
  depositConfirmed     Boolean   @default(false)
  confirmed            Boolean   @default(false)
  withdrawn            Boolean   @default(false)
  dropReason           String?
  f2Complete           Boolean   @default(false)
  f2CompletedAt        DateTime?
  f2VerifiedBy         String?
  snoozedUntil         DateTime?
  lastRemindedAt       DateTime?
  reminderCount        Int       @default(0)
  stateChangedAt       DateTime  @default(now())
  stateChangedBy       String?
  createdAt            DateTime  @default(now())

  @@index([tripId])
}

// A versioned document received from the agency (itinerary, budget). Manages
// version chaos rather than eliminating it (agency-as-receiver principle,
// FR-010/011/012). file_ref is a link/reference only — no real file upload
// (local-first, no cloud storage; the agency keeps its own PDF flow).
model AgencyDocument {
  id           String   @id @default(uuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type         String
  versionLabel String
  date         DateTime
  isCurrent    Boolean  @default(false)
  changelog    String?
  fileRef      String?
  createdAt    DateTime @default(now())

  @@index([tripId, type])
}

// An agency price band by confirmed group size (FR-013). `price` is a plain
// Int (whole currency units, no cents) — Solanum does not process money;
// this is a display-only figure for the board (product vision).
model PriceTier {
  id      String @id @default(uuid())
  tripId  String
  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  minSize Int
  maxSize Int
  price   Int

  @@index([tripId])
}
