# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Local SQLite database (ADR-002). Kept Postgres-compatible for later deploy.
DATABASE_URL="file:./dev.db"

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Initial exec-board operator created by `npm run db:seed`.
SEED_OPERATOR_EMAIL="board@solanum.local"
SEED_OPERATOR_PASSWORD="change-me"
SEED_OPERATOR_NAME="Exec board"
